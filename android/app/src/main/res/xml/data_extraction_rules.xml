<?xml version="1.0" encoding="utf-8"?>
<!-- 数据提取规则：Android 12+ 备份/设备迁移专用 -->
<data-extraction-rules>
    <!-- 云端备份规则 -->
    <cloud-backup>
        <include domain="sharedpref" path="."/>
        <include domain="database" path="."/>
        <include domain="file" path="."/>
        <exclude domain="file" path="cache/"/>
    </cloud-backup>
    <!-- 设备迁移（换机）规则 -->
    <device-transfer>
        <include domain="sharedpref" path="."/>
        <include domain="database" path="."/>
        <include domain="file" path="."/>
    </device-transfer>
</data-extraction-rules>
